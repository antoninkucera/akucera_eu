---
import Layout from '../../layouts/Layout.astro';
import SpeakingItemCard from '../../components/SpeakingItemCard.astro';
import TopicCardGrid from '../../components/TopicCardGrid.astro';
import ContactForm from '../../components/ContactForm.astro';
import { contentCS } from '../../data/content';

const c = contentCS;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout content={c} lang="cs">
  <!-- Hero Section -->
  <section class="py-6 md:py-12 flex flex-col items-start gap-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono">
      <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
      {c.hero.tagline}
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight font-serif">
      {c.hero.title1} <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-indigo-400 via-blue-400 to-cyan-400 bg-clip-text text-transparent">
        {c.hero.title2}
      </span>
    </h1>

    <p class="text-lg md:text-xl text-slate-300 max-w-2xl font-normal leading-relaxed">
      {c.hero.description}
    </p>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <a 
        href="https://antoninkucera.substack.com/" 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-medium shadow-lg shadow-orange-600/25 transition-all hover:scale-[1.02]"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
        </svg>
        {c.hero.btnSubstack}
      </a>

      <a 
        href="https://github.com/antoninkucera" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-200 font-medium transition-colors"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        {c.hero.btnGithub}
      </a>
    </div>
  </section>

  <!-- Bio & Story Section -->
  <section id="about" class="py-12 border-t border-slate-800/60">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <div>
        <span class="inline-block px-3 py-1 rounded-md bg-indigo-500/10 text-indigo-400 text-xs font-mono mb-2">
          {c.bio.badge}
        </span>
        <h2 class="text-2xl md:text-3xl font-bold text-white font-serif mb-3">{c.bio.title}</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-4">
          {c.bio.subtitle}
        </p>
        <a 
          href={`${baseUrl}/antonin-kucera-data-strategist-head-of-bi/`} 
          class="inline-flex items-center gap-1.5 text-xs font-mono text-indigo-400 hover:underline mb-4 block font-semibold"
        >
          {c.bio.readMoreBio} &rarr;
        </a>
        <div class="inline-flex items-center gap-2 p-3 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300">
          <svg class="w-4 h-4 text-indigo-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
          {c.bio.vseTag}
        </div>
      </div>

      <div class="md:col-span-2 space-y-4 text-slate-300 leading-relaxed text-base">
        <p>{c.bio.p1}</p>
        <p>{c.bio.p2}</p>
        <p>{c.bio.p3}</p>
        <p>{c.bio.p4}</p>
      </div>
    </div>
  </section>

  <!-- Expanded Topics & Categories Grid -->
  <section id="topics" class="py-12 border-t border-slate-800/60">
    <div class="space-y-2 mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-white font-serif">{c.topicsSection.title}</h2>
      <p class="text-slate-400 text-sm">{c.topicsSection.subtitle}</p>
    </div>

    <TopicCardGrid items={c.topicsSection.items} />
  </section>

  <!-- Substack & Newsletter Showcase -->
  <section id="substack" class="py-12 border-t border-slate-800/60">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 p-8 md:p-10">
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-orange-500/10 rounded-full blur-3xl"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="space-y-4 max-w-xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-mono">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
            </svg>
            {c.substack.badge}
          </div>
          
          <h2 class="text-2xl md:text-3xl font-bold text-white font-serif">
            {c.substack.title}
          </h2>
          
          <p class="text-slate-400 text-sm leading-relaxed">
            {c.substack.description}
          </p>
        </div>

        <div class="w-full md:w-auto flex flex-col gap-3">
          <a 
            href="https://antoninkucera.substack.com/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-orange-500 hover:bg-orange-400 text-white font-semibold text-center rounded-xl shadow-lg shadow-orange-500/20 transition-all hover:scale-[1.02]"
          >
            {c.substack.btnSubscribe}
          </a>
          <span class="text-center text-xs text-slate-500 font-mono">{c.substack.hint}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Public Speaking & Podcasts -->
  <section id="speaking" class="py-12 border-t border-slate-800/60">
    <div class="space-y-2 mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-white font-serif">{c.speaking.title}</h2>
      <p class="text-slate-400 text-sm">{c.speaking.subtitle}</p>
    </div>

    <div class="space-y-4">
      {c.speaking.items.map((item) => (
        <SpeakingItemCard item={item} />
      ))}
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact" class="py-12 border-t border-slate-800/60">
    <ContactForm content={c.contact} />
  </section>
</Layout>
