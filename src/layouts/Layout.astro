---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Antonín Kučera — Data Analytics, GCP, AI & BI",
  description = "Osobní profil, rozcestník projektů, newsletter a CV. Specialist na Google Cloud Platform, data analytics, AI a Business Intelligence."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://akucera.eu");
---

<!doctype html>
<html lang="cs" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Antonín Kučera" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="akucera.eu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- AI Agent discovery (RFC 8288 / llms.txt) -->
    <link rel="service-doc" type="text/plain" href="/llms.txt" title="LLM-friendly site overview" />
    <link rel="describedby" type="text/plain" href="/llms-full.txt" title="Full LLM-readable description" />

    <!-- Structured Data (Schema.org Person) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Antonín Kučera",
        "url": "https://akucera.eu",
        "jobTitle": "Data Analytics & AI Specialist",
        "knowsAbout": [
          "Google Cloud Platform",
          "BigQuery",
          "Data Analytics",
          "Artificial Intelligence",
          "Business Intelligence"
        ],
        "sameAs": [
          "https://github.com/akucera",
          "https://www.linkedin.com/in/antoninkucera/"
        ]
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-100 selection:bg-indigo-500 selection:text-white">
    <!-- Background glow effect -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Container wrapper -->
    <div class="relative z-10 max-w-4xl mx-auto px-6 py-8 flex-1 flex flex-col w-full">
      <!-- Navigation Header -->
      <header class="flex items-center justify-between py-6 border-b border-slate-800/60 mb-12">
        <a href="/" class="group flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-blue-400 p-0.5 shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform duration-300">
            <div class="w-full h-full bg-slate-950 rounded-full flex items-center justify-center font-mono font-bold text-indigo-400 text-sm">
              AK
            </div>
          </div>
          <span class="font-bold text-lg tracking-tight text-white group-hover:text-indigo-400 transition-colors">
            Antonín Kučera
          </span>
        </a>

        <nav class="flex items-center gap-6 text-sm font-medium text-slate-400">
          <a href="#about" class="hover:text-slate-100 transition-colors">O mně</a>
          <a href="#projects" class="hover:text-slate-100 transition-colors">Projekty</a>
          <a href="#substack" class="hover:text-indigo-400 transition-colors">Substack</a>
          <a href="#contact" class="hover:text-slate-100 transition-colors">Kontakt</a>
        </nav>
      </header>

      <!-- Main Content -->
      <main class="flex-1">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="mt-20 pt-8 border-t border-slate-800/60 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
        <div>
          &copy; {new Date().getFullYear()} Antonín Kučera. Všechna práva vyrazena.
        </div>
        <div class="flex items-center gap-4 font-mono">
          <a href="/llms.txt" class="hover:text-indigo-400 transition-colors">/llms.txt</a>
          <span class="text-slate-700">•</span>
          <a href="/llms-full.txt" class="hover:text-indigo-400 transition-colors">/llms-full.txt</a>
        </div>
      </footer>
    </div>
  </body>
</html>
