---
import type { SpeakingItem } from '../data/content';

interface Props {
  item: SpeakingItem;
}

const { item } = Astro.props;
---

<div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800/80 hover:border-slate-700 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-4 group">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3.5 flex-1">
    <span class="px-2.5 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-mono text-xs font-semibold flex-shrink-0">
      {item.date}
    </span>
    
    <div>
      <h3 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors flex items-center gap-2">
        {item.title}
      </h3>
      <div class="flex items-center gap-2 mt-0.5">
        {item.eventLink ? (
          <a href={item.eventLink} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-slate-400 hover:text-slate-200 underline">
            {item.event}
          </a>
        ) : (
          <span class="text-xs font-mono text-slate-400">{item.event}</span>
        )}
      </div>
    </div>
  </div>

  <!-- Action Links & Downloads -->
  <div class="flex flex-wrap items-center gap-2 font-mono text-xs self-start md:self-center">
    {item.talkLink && (
      <a 
        href={item.talkLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-indigo-400 font-medium transition-colors inline-flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        Link &rarr;
      </a>
    )}

    {item.videoLink && (
      <a 
        href={item.videoLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/20 hover:bg-red-500/20 text-red-400 font-medium transition-colors inline-flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
        Video
      </a>
    )}

    {item.pdfLink && (
      <a 
        href={item.pdfLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 hover:bg-emerald-500/20 text-emerald-400 font-medium transition-colors inline-flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download PDF
      </a>
    )}

    {item.additionalLinks?.map((addLink) => (
      <a 
        href={addLink.url} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-2.5 py-1 rounded-md bg-slate-800/80 text-slate-400 hover:text-slate-200 transition-colors text-[11px]"
      >
        {addLink.label}
      </a>
    ))}
  </div>
</div>
